#!/usr/bin/env python3

"""
Finnish alcohol licence data importer.

Phase 1:
- Read the official LVV XLSX file.
- Use the anniskelu sheet only.
- Normalize the Finnish column names.
- Do not modify the existing lead pipeline.
"""

from __future__ import annotations

from pathlib import Path

import pandas as pd


DEFAULT_FILE = (
    Path.home()
    / "Downloads"
    / "luparekisteri-voimassaolevat-alkoholiluvat.xlsx"
)

SHEET_NAME = "anniskelu"

COLUMN_MAP = {
    "asiakastunnus": "operator_id",
    "lupanumero": "licence_number",
    "nimi": "location_name",
    "katuosoite": "street_address",
    "postinumero": "postal_code",
    "postitoimipaikka": "postal_locality",
    "kunta": "municipality",
    "asiakkaan-nimi": "operator_name",
    "alkamispaivamaara": "licence_start_date",
    "paattamispaivamaara": "licence_end_date",
}


def load_finland_licences(
    path: Path = DEFAULT_FILE,
) -> pd.DataFrame:
    """Load and normalize current Finnish alcohol-serving licences."""

    if not path.exists():
        raise FileNotFoundError(
            f"Finnish licence file not found: {path}"
        )

    df = pd.read_excel(
        path,
        sheet_name=SHEET_NAME,
    )

    missing = set(COLUMN_MAP) - set(df.columns)

    if missing:
        raise ValueError(
            "Finnish dataset is missing expected columns: "
            + ", ".join(sorted(missing))
        )

    df = df[list(COLUMN_MAP)].rename(columns=COLUMN_MAP)

    df["licence_start_date"] = pd.to_datetime(
        df["licence_start_date"],
        format="%d.%m.%Y",
        errors="coerce",
    )

    df["licence_end_date"] = pd.to_datetime(
        df["licence_end_date"],
        format="%d.%m.%Y",
        errors="coerce",
    )

    return df

def add_location_key(df: pd.DataFrame) -> pd.DataFrame:
    """Add a normalized physical-location key."""

    df = df.copy()

    key_columns = [
        "street_address",
        "postal_code",
        "municipality",
    ]

    for column in key_columns:
        df[column] = (
            df[column]
            .fillna("")
            .astype(str)
            .str.strip()
            .str.upper()
        )

    df["location_key"] = (
        df["street_address"]
        + "|"
        + df["postal_code"]
        + "|"
        + df["municipality"]
    )

    return df



def main() -> None:
    """Run a read-only inspection of the Finnish dataset."""

    df = load_finland_licences()
    df = add_location_key(df)


    print("Finland Alcohol Licence Importer")
    print("=================================")
    print(f"Source file : {DEFAULT_FILE}")
    print(f"Sheet       : {SHEET_NAME}")
    print(f"Records     : {len(df)}")
    print(f"Unique locations: {df['location_key'].nunique()}")
    print()
    print("Normalized columns:")
    for column in df.columns:
        print(f"- {column}")

    print()
    print("First 5 records:")
    print(df.head(5).to_string(index=False))


if __name__ == "__main__":
    main()

